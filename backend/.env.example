DB_USER=your_user
DB_PASSWORD=your_password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=your_db_name

# --- Active Directory ---
# Use ldaps:// (porta 636). ldap:// envia a senha do usuário em texto puro.
LDAP_SERVER_URI=ldaps://dc01.your-domain.local
# Sufixo do UPN: o login "joao.silva" vira "joao.silva@your-domain.local"
LDAP_DOMAIN=your-domain.local
# Somente contas dentro desta OU (e sub-OUs) podem entrar
LDAP_ALLOWED_OU_DN=OU=TI,DC=your-domain,DC=local
LDAP_TIMEOUT_SECONDS=5
# Só use false em laboratório com certificado autoassinado
LDAP_VALIDATE_CERT=true

# --- Sessão (JWT) ---
# Gere com: uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_EXPIRE_MINUTES=480

# --- Agentes PowerShell ---
# Mesma chave vai no campo ApiKey do config.json dos scanners.
# Vazio = POST de inventário aberto (modo legado, gera aviso no log).
SCANNER_API_KEY=

# --- Logs ---
# Nível dos logs no console: DEBUG, INFO, WARNING ou ERROR.
LOG_LEVEL=INFO
